# ARIA — AI Regulatory Inspection Accelerator
# Environment Variables Template
# Copy to .env and populate before running locally

# === AZURE OPENAI ===
AZURE_OPENAI_ENDPOINT=https://<your-aoai>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# === AZURE DOCUMENT INTELLIGENCE ===
AZURE_DI_ENDPOINT=https://<your-di>.cognitiveservices.azure.com/

# === AZURE AI SEARCH ===
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_INDEX_CASES=aria-cases

# === AZURE COSMOS DB ===
AZURE_COSMOS_ENDPOINT=https://<your-cosmos>.documents.azure.com:443/
AZURE_COSMOS_DATABASE=aria

# === AZURE BLOB STORAGE ===
AZURE_STORAGE_ACCOUNT_NAME=<your-storage>

# === AZURE KEY VAULT ===
AZURE_KEY_VAULT_URL=https://<your-kv>.vault.azure.net/

# === DURABLE FUNCTIONS ===
DURABLE_TASK_HUB_NAME=AriaHub

# === PLATFORM CONFIGURATION ===
ARIA_TEMPLATE_ID=food-safety
ARIA_TEMPLATE_VERSION=1.0.0
ARIA_MAX_CONCURRENT_DOCUMENTS=3
ARIA_DI_QUALITY_THRESHOLD=0.75
ARIA_DI_CONFIDENCE_THRESHOLD=0.85

# === DELIVERY ===
# Callback secret loaded from Key Vault — do not set here
# CALLBACK_SECRET_KEY_VAULT_REFERENCE=aria-callback-secret

# === LOCAL DEVELOPMENT ONLY ===
AZURE_CLIENT_ID=<managed-identity-client-id>