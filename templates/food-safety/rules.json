  {
    "id": "CROSS_DOC_RULES",
    "category": "CrossDocumentConsistency",
    "countryFields": [
      "country_of_origin",
      "countryOfOrigin",
      "port_of_loading",
      "port_of_discharge"
    ],
    "dateFields": [
      "invoice_date",
      "issue_date",
      "declaration_date",
      "expiry_date",
      "production_date",
      "slaughter_date"
    ],
    "documentFallbacks": [
      {"whenAbsent": ["Packing_List", "Stretching_List"], "use": "Invoice"}
    ],
    "lineItemSources": ["Packing_List", "Stretching_List", "Invoice"],
    "documentAliases": {
      "HouseBill": "House_Bill",
      "DeliveryOrders": "Delivery_Orders",
      "PackingList": "Packing_List",
      "StretchingList": "Stretching_List",
      "Invoice": "Invoice",
      "CertificateOfOrigin": "Certificate_Of_Origin",
      "IssuingCountryOfOriginCertificate": "Issuing_Country_Of_Origin_Certificate",
      "HealthCertificateFromCountryOfOrigin": "Health_Certificate_from_Country_of_Origin",
      "HealthLicense": "Health_License",
      "HalalSlaughterCertificate": "Halal_Slaughter_Certificate",
      "StatisticalDeclarationGCC": "Statistical_Declaration",
      "GCCDeclaration": "GCC_Declaration",
      "CommercialLicense": "Commercial_License",
      "ImportLicense": "Import_License",
      "SignatureAuthorization": "Signature_Authorization",
      "FishImportLicense": "Fish_Import_License",
      "ShrimpImportLicense": "Shrimp_Import_License",
      "ZubaidiImportLicense": "Zubaidi_Import_License"
    },
    "crossDocumentRules": [
      {
        "ruleId": "CROSS_IMPORTER_NAME",
        "field": "importer_name",
        "documents": ["Invoice", "Packing_List", "House_Bill", "Health_Certificate_from_Country_of_Origin", "Certificate_Of_Origin", "Delivery_Orders", "Statistical_Declaration"],
        "comparisonType": "fuzzyMatch",
        "threshold": "0.85",
        "severity": "Warning",
        "description": "Consignee name doesn't match — verify the same company appears on all documents"
      },
      {
        "ruleId": "CROSS_EXPORTER_NAME",
        "field": "exporter_name",
        "documents": ["Invoice", "Packing_List", "House_Bill", "Health_Certificate_from_Country_of_Origin", "Certificate_Of_Origin"],
        "comparisonType": "fuzzyMatch",
        "threshold": "0.85",
        "severity": "Warning",
        "description": "Exporter/shipper name doesn't match — verify the same supplier appears on all documents"
      },
      {
        "ruleId": "CROSS_INVOICE_NUMBER",
        "field": "invoice_number",
        "documents": ["Invoice", "Packing_List", "House_Bill", "Certificate_Of_Origin", "Health_Certificate_from_Country_of_Origin"],
        "comparisonType": "exactMatch",
        "severity": "Warning",
        "description": "Invoice number differs across documents — all documents should reference the same invoice"
      },
      {
        "ruleId": "CROSS_INVOICE_DATE",
        "field": "invoice_date",
        "documents": ["Invoice", "Packing_List", "House_Bill", "Certificate_Of_Origin"],
        "comparisonType": "exactMatch",
        "severity": "Warning",
        "description": "Invoice date differs across documents — verify the correct date with the importer"
      },
      {
        "ruleId": "CROSS_HS_CODE",
        "field": "hs_code",
        "documents": ["Invoice", "House_Bill", "Statistical_Declaration"],
        "comparisonType": "exactMatch",
        "severity": "Warning",
        "description": "HS code differs across documents — the tariff code must be identical on all customs documents"
      },
      {
        "ruleId": "CROSS_ITEM_DESCRIPTION",
        "field": "item_description",
        "documents": ["Invoice", "Packing_List", "House_Bill", "Certificate_Of_Origin"],
        "comparisonType": "semanticMatch",
        "threshold": 0.85,
        "severity": "Warning",
        "description": "Product description doesn't match — verify all documents describe the same goods"
      },
      {
        "ruleId": "CROSS_QUANTITY",
        "field": "quantity",
        "documents": ["Invoice", "Packing_List", "House_Bill", "Delivery_Orders"],
        "comparisonType": "exactMatch",
        "severity": "Warning",
        "description": "Quantity values differ across documents — confirm the correct quantity with the importer"
      },
      {
        "ruleId": "CROSS_NET_WEIGHT",
        "field": "net_weight",
        "documents": ["Invoice", "Packing_List", "House_Bill", "Health_Certificate_from_Country_of_Origin", "Certificate_Of_Origin"],
        "comparisonType": "exactMatch",
        "severity": "Warning",
        "description": "Net weight values differ across documents — confirm the correct weight with the importer"
      },
      {
        "ruleId": "CROSS_GROSS_WEIGHT",
        "field": "gross_weight",
        "documents": ["Invoice", "House_Bill", "Certificate_Of_Origin", "Statistical_Declaration"],
        "comparisonType": "exactMatch",
        "severity": "Warning",
        "description": "Gross weight values differ across documents — confirm the correct weight with the importer"
      },
      {
        "ruleId": "CROSS_COUNTRY_OF_ORIGIN",
        "field": "country_of_origin",
        "documents": ["Invoice", "House_Bill", "Health_Certificate_from_Country_of_Origin", "Certificate_Of_Origin", "Statistical_Declaration"],
        "comparisonType": "exactMatch",
        "severity": "Warning",
        "description": "Country of origin differs across documents — all documents must declare the same origin"
      },
      {
        "ruleId": "CROSS_PORT_OF_LOADING",
        "field": "port_of_loading",
        "documents": ["House_Bill", "Certificate_Of_Origin", "Statistical_Declaration"],
        "comparisonType": "exactMatch",
        "severity": "Warning",
        "description": "Port of loading differs across documents — verify the correct loading port with the shipper"
      },
      {
        "ruleId": "CROSS_PORT_OF_DISCHARGE",
        "field": "port_of_discharge",
        "documents": ["House_Bill", "Certificate_Of_Origin", "Statistical_Declaration"],
        "comparisonType": "exactMatch",
        "severity": "Warning",
        "description": "Port of discharge differs across documents — verify the correct destination port"
      },
      {
        "ruleId": "CROSS_PACKAGING",
        "field": "packaging",
        "documents": ["Invoice", "Packing_List", "House_Bill", "Certificate_Of_Origin"],
        "comparisonType": "fuzzyMatch",
        "threshold": 0.85,
        "severity": "Warning",
        "description": "Packaging description doesn't match — verify all documents describe the same packaging"
      }
    ]
  },

  {
    "id": "TEMPORAL_RULES",
    "category": "TemporalValidity",
    "isActive": "True",
    "temporalRules": [
      {
        "ruleId": "FOOD_NOT_EXPIRED",
        "scope": "item",
        "operator": "after",
        "reference": "today",
        "valueField": "expiryDate",
        "lineItemField": "expiry_date",
        "labelField": "itemType",
        "lineItemSources": [
          {"documentType": "Packing_List", "documentTypeId": "48"},
          {"documentType": "Stretching_List", "documentTypeId": "49"},
          {"documentType": "Invoice", "documentTypeId": "50"}
        ],
        "missingResult": "WARN",
        "failResult": "FAIL",
        "missingMessage": "Item '{item}' expiry date could not be verified (not found in any document line items).",
        "failMessage": "Item '{item}' has already expired (expiry date: {value}, source: {source}).",
        "description": "Food must not be already expired"
      },
      {
        "ruleId": "ISSUE_DATE_NOT_IN_FUTURE",
        "scope": "document",
        "operator": "notAfter",
        "reference": "today",
        "fields": [
          "issue_date",
          "certificate_issue_date",
          "license_issue_date",
          "license_start_date"
        ],
        "appliesTo": [
          {"documentType": "Halal_Slaughter_Certificate", "documentTypeId": "21"},
          {"documentType": "Health_License", "documentTypeId": "40"},
          {"documentType": "Health_Certificate_Country_of_Origin", "documentTypeId": "27"},
          {"documentType": "Fish_Import_License", "documentTypeId": "24"},
          {"documentType": "Shrimp_Import_License", "documentTypeId": "26"},
          {"documentType": "Zubaidi_Import_License", "documentTypeId": "25"},
          {"documentType": "Commercial_License", "documentTypeId": "52"},
          {"documentType": "Import_License", "documentTypeId": "53"}
        ],
        "failResult": "FAIL",
        "failMessage": "{documentType} has an issue date in the future ({value}). The document may be invalid.",
        "description": "Document issue date cannot be in the future"
      },
      {
        "ruleId": "CERTIFICATE_NOT_EXPIRED",
        "scope": "document",
        "operator": "after",
        "reference": "today",
        "fields": [
          "expiry_date",
          "certificate_expiry_date",
          "license_expiry_date",
          "certificate_valid_until"
        ],
        "appliesTo": [
          {"documentType": "Halal_Slaughter_Certificate", "documentTypeId": "21"},
          {"documentType": "Health_License", "documentTypeId": "40"},
          {"documentType": "Health_Certificate_Country_of_Origin", "documentTypeId": "27"},
          {"documentType": "Fish_Import_License", "documentTypeId": "24"},
          {"documentType": "Shrimp_Import_License", "documentTypeId": "26"},
          {"documentType": "Zubaidi_Import_License", "documentTypeId": "25"},
          {"documentType": "Commercial_License", "documentTypeId": "52"},
          {"documentType": "Import_License", "documentTypeId": "53"}
        ],
        "failResult": "FAIL",
        "failMessage": "{documentType} has expired (expiry date: {value}).",
        "description": "Certificate must still be valid at time of inspection"
      }
    ]
  },

  {
    "id": "ITEM_RECONCILIATION_RULES",
    "category": "ItemReconciliation",
    "isActive": "True",
    "description": "Reconcile declared payload items against extracted document line items.",
    "lineItemSources": ["Packing_List", "Stretching_List", "Invoice"],
    "labelFields": ["item_description", "product_description", "goods_description"],
    "tolerances": {"default": 0.02, "conditional": 0.05},
    "derivedValues": [
      {
        "name": "netWeightKg",
        "operator": "product",
        "round": 3,
        "operands": [
          {"attribute": "itemQty"},
          {"attribute": "pack", "default": 1},
          {
            "attribute": "netUnitWgt",
            "unitAttribute": "itemUnit",
            "defaultUnit": "g",
            "unitMultipliers": {"g": 0.001, "kg": 1, "mt": 1000, "t": 1000}
          }
        ]
      }
    ],
    "sanityChecks": [
      {"id": "ITEM_NW_MISSING", "attribute": "netUnitWgt", "check": "required", "label": "net unit weight"},
      {"id": "ITEM_NW_INVALID", "derived": "netWeightKg", "check": "positive", "label": "net weight"},
      {"id": "ITEM_NW_UNREALISTIC", "derived": "netWeightKg", "check": "maximum", "value": 1000000.0, "label": "net weight"}
    ],
    "comparisons": [
      {
        "id": "ITEM_QTY",
        "type": "numeric",
        "declared": {"attribute": "itemQty"},
        "extracted": {"fields": ["quantity_or_number_of_packages", "quantity"]}
      },
      {
        "id": "ITEM_NW",
        "type": "numeric",
        "declared": {"derived": "netWeightKg"},
        "extracted": {"fields": ["net_weight"]},
        "conditionalTolerance": true,
        "unitInference": {"threshold": 500.0, "multiplier": 1000}
      },
      {
        "id": "ITEM_COO",
        "type": "country",
        "declared": {"attribute": "countryOfOrigin"},
        "extracted": {"fields": ["country_of_origin_per_item", "country_of_origin"]}
      },
      {
        "id": "ITEM_EXP",
        "type": "date",
        "declared": {"attribute": "expiryDate"},
        "extracted": {"fields": ["expiry_date"]}
      },
      {
        "id": "ITEM_PROD",
        "type": "date",
        "declared": {"attribute": "prodDate"},
        "extracted": {"fields": ["production_date"]}
      }
    ],
    "crossDocumentComparison": {
      "id": "ITEM_NW_XDOC",
      "derived": "netWeightKg",
      "fields": ["net_weight"],
      "unitInference": {"threshold": 500.0, "multiplier": 1000}
    },
    "aggregate": {
      "id": "ITEM_NW_TOTAL",
      "derived": "netWeightKg",
      "fields": ["total_net_weight", "net_weight_total"],
      "unitInference": {"threshold": 500.0, "multiplier": 1000}
    }
  }
]
